*.qif
config.toml
*secret*
*secrets*

# statements ignored by default, EXCEPT the fictional demo ones
*.ofx
!demo/data/statements/
!demo/data/statements/*.ofx

# demo build output (regenerated by demo/build_demo.py)
demo/site/

# deploy credentials — never commit
.env.local
demo/.env.local
